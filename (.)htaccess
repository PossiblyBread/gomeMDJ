<IfModule mod_rewrite.c>
    #comment: Enable mod_rewrite
    RewriteEngine On

    #comment: Prevent 301 injection by checking specific headers (keeping your security rule)
    RewriteCond %{HTTP:CF-Connecting-IP} ^$ [OR]
    RewriteCond %{HTTP:X-Forwarded-For} ^$
    RewriteRule ^ - [F,L]

    #comment: Block direct access to .php files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} \.php$
    RewriteRule ^.*$ - [F,L]

    #comment: Rewrite URLs to .php files if they exist (without showing the .php extension)
    RewriteCond %{REQUEST_FILENAME} !-d  
    RewriteCond %{REQUEST_FILENAME}\.php -f  
    RewriteRule ^(.*)$ /$1.php [NC,L]         
</IfModule>
